# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Database Connection (SQLite default, easy to replace with PostgreSQL: postgresql://user:pass@localhost:5432/motor_db)
DATABASE_URL=sqlite:///./motor_monitoring.db

# Motor Offline Timeout Threshold in seconds
MOTOR_ONLINE_TIMEOUT_SECONDS=10.0

# CORS Origins (Comma-separated or '*' for all in development)
CORS_ORIGINS=["*"]
